{
  "artifact.write": {
    "additionalProperties": false,
    "properties": {
      "artifact_id": { "type": "string", "minLength": 1 },
      "body_ref": { "type": "string", "minLength": 1 },
      "byte_count": { "description": "decimal string, u64", "pattern": "^[0-9]+$", "type": "string" },
      "content_hash": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
      "format": { "enum": ["txt", "md", "csv", "json"], "type": "string" },
      "grant_id": { "type": "string", "minLength": 1 },
      "version_id": { "type": "string", "minLength": 1 }
    },
    "required": ["grant_id", "artifact_id", "version_id", "format", "body_ref", "content_hash", "byte_count"],
    "type": "object"
  },
  "workspace.list": {
    "additionalProperties": false,
    "properties": {
      "cursor": { "type": "string" },
      "grant_id": { "type": "string", "minLength": 1 },
      "limit": { "description": "decimal string, 1..200", "pattern": "^[0-9]+$", "type": "string" },
      "relative_dir": { "type": "string" }
    },
    "required": ["grant_id", "relative_dir", "limit"],
    "type": "object"
  },
  "workspace.read": {
    "additionalProperties": false,
    "properties": {
      "entry_ref": { "type": "string", "minLength": 1 },
      "expected_identity": { "type": "string" },
      "grant_id": { "type": "string", "minLength": 1 },
      "max_bytes": { "description": "decimal string, 1..262144", "pattern": "^[0-9]+$", "type": "string" }
    },
    "required": ["grant_id", "entry_ref", "expected_identity", "max_bytes"],
    "type": "object"
  },
  "workspace.search": {
    "additionalProperties": false,
    "properties": {
      "grant_id": { "type": "string", "minLength": 1 },
      "limit": { "description": "decimal string, 1..100", "pattern": "^[0-9]+$", "type": "string" },
      "literal_query": { "maxLength": 256, "minLength": 1, "type": "string" },
      "relative_dir": { "type": "string" }
    },
    "required": ["grant_id", "relative_dir", "literal_query", "limit"],
    "type": "object"
  }
}
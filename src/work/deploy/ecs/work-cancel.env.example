# work-cancel 配置模板(仅组织清单与批量上限,不含密钥)
#
# 用法:在 Work ECS 上创建并收紧权限:
#   sudo cp work-cancel.env.example /etc/work/work-cancel.env
#   sudo chown root:work-control /etc/work/work-cancel.env
#   sudo chmod 640 /etc/work/work-cancel.env
#   sudoedit /etc/work/work-cancel.env   # 填入要消费取消意图的 org id
#
# DB 连接复用 /etc/work/work-worker.env(work-cancel.service 里两个 EnvironmentFile 合并
# 加载),避免第二份密钥副本漂移。本文件只放"消费哪些 org"和每轮上限。
#
# 多租户 RLS 按 org 隔离,work_worker 身份无法跨组织枚举 org,因此每个开通的组织都要列出。
# 新增组织时追加 id(空格分隔)。跨组织全局 claim 需要仿 app.outbox_relay 新开一个跨租户
# 可见性开关,主签已否(2026-11-17),所以清单是配置而不是查询。
WORK_CANCEL_ORGS=4a2d3f28-38b9-4d6c-8614-70ef9a83960d

# 每轮上限(控制面 §6.1:≤100 Task、≤500 条待消费意图/org)。命令内部还会再夹一次,
# 所以这里填大于上限的值不会放宽裁定;填 0 或非法值回落到 100/500。
# 超量的意图保持 pending 且 next_attempt 不变,下一轮继续,不跳过。
WORK_CANCEL_TASK_LIMIT=100
WORK_CANCEL_INTENT_LIMIT=500
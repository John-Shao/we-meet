# work-runtime: Node/Pi advanceRuntime listener (needs Node >= 22).
WORK_RUNTIME_LISTEN_ADDR=127.0.0.1:8446
WORK_RUNTIME_TLS_CERT=/etc/work/runtime-ca/work-runtime.crt
WORK_RUNTIME_TLS_KEY=/etc/work/runtime-ca/work-runtime.key
WORK_RUNTIME_CLIENT_CA=/etc/work/runtime-ca/ca.crt
WORK_HOLDER_ID=work-parent-1
WORK_RUNTIME_VERSION=pi-1.4.0-r0a
WORK_MAX_CONCURRENT=2
WORK_AUTHZ_URL=https://127.0.0.1:8443
WORK_AUTHZ_CERT=/etc/work/runtime-ca/work-parent.crt
WORK_AUTHZ_KEY=/etc/work/runtime-ca/work-parent.key
WORK_AUTHZ_CA=/etc/work/runtime-ca/ca.crt
WORK_AUTHZ_SERVER_NAME=work-authz
WORK_CONTENT_PROXY_URL=https://127.0.0.1:8444
WORK_EGRESS_URL=https://127.0.0.1:8445

# work-reconcile-scan 配置模板(仅组织清单,不含密钥)
#
# 用法:在 Work ECS 上创建并收紧权限:
#   sudo cp work-reconcile-scan.env.example /etc/work/work-reconcile-scan.env
#   sudo chown root:work-control /etc/work/work-reconcile-scan.env
#   sudo chmod 640 /etc/work/work-reconcile-scan.env
#   sudoedit /etc/work/work-reconcile-scan.env   # 填入要巡检的 org id
#
# DB 连接与 Temporal mTLS 复用 /etc/work/work-worker.env(work-reconcile-scan.service 里
# 两个 EnvironmentFile 合并加载),避免第二份密钥副本漂移。本文件只放"巡检哪些 org"。
#
# 定时任务只做只读孤儿巡检(-scan),不改任何业务账本;命中或扫描失败以非零退出把单元
# 标红,on-call 再用 work-reconcile 写路径按工单人工核对(Runbook §5.13/§5.16)。
#
# 多租户 RLS 按 org 隔离,worker 身份无法跨组织枚举 org,因此每个开通的试点组织都要列出。
# 新增组织时追加 id(空格分隔)。
WORK_RECONCILE_ORGS=4a2d3f28-38b9-4d6c-8614-70ef9a83960d

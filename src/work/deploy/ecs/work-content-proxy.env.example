# work-content-proxy: bound reads and checkpoint-candidate writes for the runtime child.
# Must use the same Content Store master key as work-api/worker.
WORK_DATABASE_URL=postgresql://work_worker_login:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/work?sslmode=disable
WORK_CONTENT_MASTER_KEY=REPLACE_WITH_WORK_API_CONTENT_KEY
WORK_CONTENT_DIR=/var/lib/work/content
WORK_CONTENT_PROXY_LISTEN_ADDR=127.0.0.1:8444
WORK_CONTENT_PROXY_CERT=/etc/work/runtime-ca/work-content-proxy.crt
WORK_CONTENT_PROXY_KEY=/etc/work/runtime-ca/work-content-proxy.key
# D4 §6.3: server TLS + work-content bearer; callers present no client cert.

# work-relay unit environment (template; copy to /etc/work/work-relay.env).
# Every key here is read by cmd/work-relay.

# Outbox events claimed per poll. Empty means 20 (main.go:65).
WORK_RELAY_BATCH_SIZE=20

# Lease seconds for a claimed event; a relay that dies must let another take over after
# this window. Empty means 60 (main.go:66); claim_outbox rejects leases outside 5..600.
WORK_RELAY_LEASE_SECONDS=60

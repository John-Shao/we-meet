[Unit]
Description=Work outbox relay
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=work-control
Group=work-control
EnvironmentFile=/etc/work/work-relay.env
ExecStart=/usr/local/bin/work-relay
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# content_shred events delete encrypted objects under the local pilot store.
ReadWritePaths=/var/lib/work/content

[Install]
WantedBy=multi-user.target

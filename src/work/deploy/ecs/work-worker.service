[Unit]
Description=Work RunWorkflow worker (pilot runtime)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=work-control
Group=work-control
EnvironmentFile=/etc/work/work-worker.env
ExecStart=/usr/local/bin/work-worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/work/content

[Install]
WantedBy=multi-user.target

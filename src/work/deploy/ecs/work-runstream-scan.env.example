# work-runstream-scan 配置模板（C17 最小集：组织清单＋阈值，不含密钥）
#
# 用法（Work ECS）：
#   sudo cp work-runstream-scan.env.example /etc/work/work-runstream-scan.env
#   sudo chown root:work-control /etc/work/work-runstream-scan.env
#   sudo chmod 640 /etc/work/work-runstream-scan.env
#
# WORK_DATABASE_URL 由 work-runstream-scan.service 里的 /etc/work/work-worker.env 提供，
# 本文件不重复放连接串（两份密钥副本迟早漂移）。
#
# 只读巡检：不改账本、不发消息。命中越限以退出码 2 把单元标红，
# work-healthcheck.sh 的观察名单会把健康状态转 degraded，投递交给已在跑的 work-health-alert.py。

# 巡检哪些组织（空格分隔）。多租户 RLS 下 worker 身份无法跨组织枚举 org，必须显式列出。
WORK_RUNSTREAM_ORGS=4a2d3f28-38b9-4d6c-8614-70ef9a83960d

# 开放态 Run 超过这么多分钟没动过、且没有活租约 → 记为「停放 Run」（判据出处见
# runstream-gauges.sql 顶部注释：Temporal 侧的 isOrphan() 看不见这一类）。
WORK_RUNSTREAM_STALE_MINUTES=5

# 临时容差的历史（原文保留，因为它解释了这个键为什么存在）：2026-11-04 演练残留 2 笔挂在已终态 Run
# 上的未释放预留（各 100,000），当时按 #56-B 的裁前状态把容差设成 2，并写明"预留归零后必须改回 0"。
# 2026-11-06：主机那份 env 早已是 0（`/etc/work/work-runstream-scan.env` 现读
# WORK_RUNSTREAM_MAX_HELD_ON_TERMINAL=0），**模板却还带着 2**——rollout 的 install_env 在缺文件时会
# 从模板新建，于是任何一次重装或新主机都会静默把容差放回 2，让"挂在终态 Run 上的未释放预留"这类
# 泄漏在前两笔上不报警。这正是回收条件里那句"改回 0"要防的事，所以模板归零：泄漏一笔即红并发信。
WORK_RUNSTREAM_MAX_HELD_ON_TERMINAL=0

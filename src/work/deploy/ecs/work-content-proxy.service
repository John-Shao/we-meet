[Unit]
Description=Work runtime content proxy (bound reads, checkpoint candidates)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=work-control
Group=work-control
EnvironmentFile=/etc/work/work-content-proxy.env
ExecStart=/usr/local/bin/work-content-proxy
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/work/content

[Install]
WantedBy=multi-user.target

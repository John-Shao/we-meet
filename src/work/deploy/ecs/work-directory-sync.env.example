# work-directory-sync unit environment (template; copy to /etc/work/work-directory-sync.env).
# Every key here is read by cmd/work-directory-sync. Runbook section 5.3 describes the
# operational meaning of these; the values below are the code defaults, restated so an
# operator does not have to read Go to run the job.

# full pulls the whole member snapshot and narrows absent members; incremental only adds.
# Empty means the code default "full" (main.go:51-61), and any other value is rejected.
WORK_DIRECTORY_MODE=full

# Wall-clock budget for one run. Empty means 10m (main.go:40-47); it must parse as a
# positive Go duration or the job refuses to start.
WORK_DIRECTORY_TIMEOUT=10m

# Optional: restrict one invocation to a single org. Left unset the job takes its
# organisation list from the directory rows it owns, so set it only for a targeted run.
WORK_DIRECTORY_ORG_ID=

# Mass-absence brake. A full sync that would mark >= max(10, 20% of candidates) members
# left is blocked by default and writes directory.member_absence_blocked. Setting this to
# 1 is an explicit operator decision after checking Host data, and it records
# directory.member_absence_applied - never leave it at 1 in the file.
WORK_DIRECTORY_ALLOW_MASS_ABSENCE=0

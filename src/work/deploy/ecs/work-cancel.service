[Unit]
Description=Work governance cancellation-intent consumer (one bounded pass)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=work-control
Group=work-control
# DB 复用 worker 环境;org 清单与批量上限单独放在 work-cancel.env。
EnvironmentFile=/etc/work/work-worker.env
EnvironmentFile=/etc/work/work-cancel.env
ExecStart=/usr/local/bin/work-cancel
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
# work-egress: one-shot trusted model egress. Holds no provider key; resolves per-org credentials.
WORK_DATABASE_URL=postgresql://work_worker_login:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/work?sslmode=disable
WORK_CONTENT_MASTER_KEY=REPLACE_WITH_WORK_API_CONTENT_KEY
WORK_CONTENT_DIR=/var/lib/work/content
WORK_AUTHZ_URL=https://127.0.0.1:8443
WORK_AUTHZ_CERT=/etc/work/runtime-ca/work-egress-client.crt
WORK_AUTHZ_KEY=/etc/work/runtime-ca/work-egress-client.key
WORK_AUTHZ_CA=/etc/work/runtime-ca/ca.crt
WORK_EGRESS_LISTEN_ADDR=127.0.0.1:8445
WORK_EGRESS_CERT=/etc/work/runtime-ca/work-egress.crt
WORK_EGRESS_KEY=/etc/work/runtime-ca/work-egress.key
# D4 §6.3: server TLS + work-egress bearer; callers present no client cert.

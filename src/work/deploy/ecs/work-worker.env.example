# Work RunWorkflow worker 配置模板
#
# 用法：不要把真实 key 直接写回本模板；在 Work ECS 上创建并收紧权限：
#   sudo cp work-worker.env.example /etc/work/work-worker.env
#   sudo chown root:work-control /etc/work/work-worker.env
#   sudo chmod 640 /etc/work/work-worker.env
#   sudoedit /etc/work/work-worker.env   # 填入下面的占位值
#   sudo systemctl daemon-reload && sudo systemctl enable --now work-worker
# 真实密钥只留在 /etc/work/work-worker.env，不要提交进仓库，也不要复用 meet 的 DashScope key。

# reference：不调用外部 provider，只用于生命周期演练；openai_compatible：真实模型调用。
WORK_RUNTIME_MODE=openai_compatible

# Work 专属 provider（OpenAI chat-completions 协议）
# 当前生产临时复用 meet 的阿里云百炼 key；Work 专属 key 下来后只替换 WORK_MODEL_API_KEY。
# 其他可选：deepseek → https://api.deepseek.com/v1 + deepseek-chat；
#           volcengine → https://ark.cn-beijing.volces.com/api/v3 + 推理接入点 ID。
WORK_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WORK_MODEL_API_KEY=REPLACE_WITH_WORK_ONLY_PROVIDER_KEY
WORK_MODEL_NAME=qwen3.8-flash
# aliyun | volcengine | deepseek
WORK_MODEL_PROVIDER=aliyun
WORK_MODEL_MAX_TOKENS=1024

# PostgreSQL：work_worker_login，仅 work_worker 成员
WORK_DATABASE_URL=postgresql://work_worker_login:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/work?sslmode=disable

# Content Store：必须与 /etc/work/work-api.env 使用同一把主密钥（64 位 hex 或 base64）
WORK_CONTENT_MASTER_KEY=REPLACE_WITH_WORK_API_CONTENT_KEY
WORK_CONTENT_DIR=/var/lib/work/content

# Temporal mTLS：与 work-relay 共用 /etc/work/temporal 下的客户端证书
WORK_TEMPORAL_ADDRESS=10.43.147.249:7233
WORK_TEMPORAL_NAMESPACE=work-r0a
WORK_TEMPORAL_TASK_QUEUE=work-r0a-run
WORK_TEMPORAL_WORKFLOW_TYPE=RunWorkflow
WORK_TEMPORAL_SERVER_NAME=temporal-server
WORK_TEMPORAL_CA=/etc/work/temporal/ca.crt
WORK_TEMPORAL_CERT=/etc/work/temporal/client.crt
WORK_TEMPORAL_KEY=/etc/work/temporal/client.key

# 配额与 worker 身份：留空 WORK_QUOTA_PERIOD 时按当前 UTC 月（YYYY-MM）
WORK_QUOTA_ACCOUNT_KEY=default
WORK_QUOTA_PERIOD=
WORK_QUOTA_LIMIT_TOKENS=1000000
WORK_QUOTA_ENFORCEMENT=soft
WORK_WORKER_ID=work-worker-1

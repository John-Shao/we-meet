# work-governance-events configuration template. Copy to
# /etc/work/work-governance-events.env and tighten permissions before enabling the timer.
# This unit uses the dedicated work_governance_events database role and a client certificate
# whose CN is work-governance-events; the work-control-plane certificate is intentionally rejected.

WORK_GOVERNANCE_ORGS=
WORK_DATABASE_URL=postgresql://work_governance_events_login:CHANGE_ME@127.0.0.1:5432/work?sslmode=require
WORK_GOVERNANCE_HOST_BASE_URL=https://meet.we-meet.online
WORK_GOVERNANCE_CLIENT_CERT=/etc/work/certs/work-governance-events.crt
WORK_GOVERNANCE_CLIENT_KEY=/etc/work/certs/work-governance-events.key
WORK_GOVERNANCE_CA=/etc/ssl/certs/ca-certificates.crt
WORK_GOVERNANCE_TIMEOUT=5m
WORK_GOVERNANCE_PAGE_LIMIT=100
WORK_GOVERNANCE_MAX_PAGES=1000

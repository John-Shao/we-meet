# work-api service environment (template; the operator copies it to /etc/work/work-api.env).
# Every key here is read by cmd/work-api. Values that are secrets are never written into this
# file - they come from the unit's own credential files, not from a template.

# HTTP listen address. Leaving it unset takes the code default 127.0.0.1:8080
# (cmd/work-api/main.go:104-107); the deployed topology reaches the API through the
# reverse proxy, so loopback is the intended value.
WORK_LISTEN_ADDR=127.0.0.1:8080

# Device CA (R0b GW20, device-design §2.1 steps 3-4). Optional at boot: without it the
# certificate face fails closed as 503 BEFORE any database write, so a missing CA cannot
# activate a device that could never hold a certificate. Both values are file PATHS; the
# key file itself is a secret and comes from the unit's credential material, never from
# this template. Production CA custody, rotation and the TPM-vs-software-CNG enterprise
# policy are the J39 sign-off item and are NOT settled by wiring these two variables.
#WORK_DEVICE_CA=/etc/work/device-ca.pem
#WORK_DEVICE_CA_KEY=/etc/work/device-ca.key

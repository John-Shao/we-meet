# work-api service environment (template; the operator copies it to /etc/work/work-api.env).
# Every key here is read by cmd/work-api. Values that are secrets are never written into this
# file - they come from the unit's own credential files, not from a template.

# HTTP listen address. Leaving it unset takes the code default 127.0.0.1:8080
# (cmd/work-api/main.go:79-82); the deployed topology reaches the API through the
# reverse proxy, so loopback is the intended value.
WORK_LISTEN_ADDR=127.0.0.1:8080

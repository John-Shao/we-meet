# work-authz: mTLS issuance/claim/renew/consume RPC for the runtime parent and egress.
# Install as /etc/work/work-authz.env (root:work-control 640); never commit real values.
WORK_DATABASE_URL=postgresql://work_worker_login:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/work?sslmode=disable
WORK_AUTHZ_LISTEN_ADDR=127.0.0.1:8443
WORK_AUTHZ_CERT=/etc/work/runtime-ca/work-authz.crt
WORK_AUTHZ_KEY=/etc/work/runtime-ca/work-authz.key
WORK_AUTHZ_CA=/etc/work/runtime-ca/ca.crt
WORK_AUTHZ_WORKLOADS=/etc/work/runtime-ca/workloads.json

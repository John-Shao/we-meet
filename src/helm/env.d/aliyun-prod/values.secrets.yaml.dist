# Production secrets for the Aliyun deployment.
#
# USAGE:
#   1. cp values.secrets.yaml.dist values.secrets.yaml
#   2. Fill in every REPLACE_* placeholder below.
#   3. Never commit values.secrets.yaml — it is gitignored via the rule
#      added in src/helm/env.d/aliyun-prod/.gitignore
#
# Generate strong secrets:
#   openssl rand -hex 32       # for DJANGO_SECRET_KEY, LIVEKIT_API_SECRET, etc.
#   openssl rand -base64 32    # for passwords

backend:
  envVars:
    DJANGO_SECRET_KEY: REPLACE_DJANGO_SECRET_KEY
    DJANGO_SUPERUSER_EMAIL: admin@example.com
    DJANGO_SUPERUSER_PASSWORD: REPLACE_ADMIN_PASSWORD

    DB_PASSWORD: REPLACE_POSTGRES_APP_PASSWORD
    REDIS_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/1
    CELERY_BROKER_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/0

    OIDC_RP_CLIENT_ID: meet
    # OIDC_RP_CLIENT_SECRET 在 setup-customer.sh 后仍保留占位 —— 这是设计如此,
    # 不是漏填. 流程:
    #   阶段 3 (aliyun-zlm) bash deploy/aliyun/keycloak/bootstrap-realm.sh
    #     脚本输出: OIDC_RP_CLIENT_SECRET=<32位 hex>
    #   回到 PC, 把那个值粘到下面这行 (替换占位字符串).
    #   再进阶段 4 helm install meet.
    # check-config.sh 在它仍是占位时只 ⚠️ 不 ❌, 不阻塞.
    OIDC_RP_CLIENT_SECRET: REPLACE_KEYCLOAK_CLIENT_SECRET

    # meet-service 机密客户端的 secret —— 移动端 OTP 登录 (Token Exchange) 用.
    # 由 deploy/aliyun/keycloak/bootstrap-mobile.sh 创建并输出.
    MOBILE_AUTH_SERVICE_CLIENT_SECRET: REPLACE_MOBILE_AUTH_SERVICE_CLIENT_SECRET

    # 火山引擎短信 AK/SK (移动端 OTP 短信发送) —— 火山引擎账号凭据.
    VOLC_SMS_AK: REPLACE_VOLC_SMS_AK
    VOLC_SMS_SK: REPLACE_VOLC_SMS_SK

    # Keycloak phone-auth 插件调 /keycloak-sms/send/ 发码时带的共享 Bearer token.
    # 必须与 Keycloak authenticator 的 sms_gateway_token 逐字符一致. 生成: openssl rand -hex 32.
    # 留空(不填)则 backend 网关跳过鉴权(AllowAny) —— 生产务必填.
    KEYCLOAK_SMS_GATEWAY_TOKEN: REPLACE_KEYCLOAK_SMS_GATEWAY_TOKEN

    LIVEKIT_API_SECRET: REPLACE_LIVEKIT_API_SECRET

    AWS_S3_ACCESS_KEY_ID: REPLACE_OSS_ACCESS_KEY_ID
    AWS_S3_SECRET_ACCESS_KEY: REPLACE_OSS_ACCESS_KEY_SECRET

    SUMMARY_SERVICE_API_TOKEN: REPLACE_SUMMARY_API_TOKEN

    # Shared secret authenticating agent workers (multi_user_transcriber, …)
    # when they POST to /api/agent/* endpoints. Generate via:
    #   openssl rand -hex 32
    AGENT_INTERNAL_API_TOKEN: REPLACE_AGENT_INTERNAL_API_TOKEN

    # Sprint 2.2.a — Meeting summary + action-item extraction uses Doubao Pro
    # via the Ark OpenAI-compatible endpoint (same Ark account as agents).
    ARK_API_KEY: REPLACE_VOLCENGINE_ARK_API_KEY

    DJANGO_EMAIL_HOST_USER: REPLACE_SMTP_USER
    DJANGO_EMAIL_HOST_PASSWORD: REPLACE_SMTP_PASSWORD

    # P6 — jusi-light-im admin HMAC secret. Must match the value seeded at
    # /etc/jusi-secrets/ADMIN_HMAC_SECRET on the im.we-meet.online ECS.
    # Generate once on the ECS: openssl rand -hex 32
    JUSI_IM_ADMIN_HMAC_SECRET: REPLACE_JUSI_IM_ADMIN_HMAC_SECRET

    # P3 协作文档 (La Suite Docs) — 妙记落 Doc 的 server-to-server token. 必须与
    # Docs 独立机 docs.values.yaml 的 DJANGO_SERVER_TO_SERVER_API_TOKENS 逐字符一致.
    # 高权限(能代任意用户建文档), 只配后端 secret, 绝不进前端. 生成: openssl rand -hex 32.
    # 留空(不填/删除)则妙记落 Doc 静默 no-op, 不影响 meet 其余功能.
    DOCS_SERVER_TO_SERVER_TOKEN: REPLACE_DOCS_SERVER_TO_SERVER_TOKEN

    # P0 offline push — jusi-light-im p14 webhook verification secret. Must
    # match secret.PUSH_WEBHOOK_SECRET on the jusi-light-im ECS byte-for-byte
    # (/etc/jusi-secrets/PUSH_WEBHOOK_SECRET). Generate once: openssl rand -hex 32.
    # Unset → backend /api/agent/push-hook/ fail-closes to 404.
    IM_PUSH_WEBHOOK_SECRET: REPLACE_IM_PUSH_WEBHOOK_SECRET

    # Getui (个推) REST v2 credentials — backend delivers offline IM pushes.
    # MasterSecret is server-side only (never ship in the APK / web / public repo).
    # AppSecret is not needed by the backend (v2 auth signs appkey+mastersecret).
    GETUI_APP_ID: REPLACE_GETUI_APP_ID
    GETUI_APP_KEY: REPLACE_GETUI_APP_KEY
    GETUI_MASTER_SECRET: REPLACE_GETUI_MASTER_SECRET

celery:
  envVars:
    DJANGO_SECRET_KEY: REPLACE_DJANGO_SECRET_KEY
    DB_PASSWORD: REPLACE_POSTGRES_APP_PASSWORD
    REDIS_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/1
    CELERY_BROKER_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/0
    AWS_S3_ACCESS_KEY_ID: REPLACE_OSS_ACCESS_KEY_ID
    AWS_S3_SECRET_ACCESS_KEY: REPLACE_OSS_ACCESS_KEY_SECRET
    LIVEKIT_API_SECRET: REPLACE_LIVEKIT_API_SECRET

summary: &summarySecretEnvVars
  envVars:
    APP_API_TOKEN: REPLACE_SUMMARY_API_TOKEN
    WEBHOOK_API_TOKEN: REPLACE_SUMMARY_WEBHOOK_TOKEN

    AWS_S3_ACCESS_KEY_ID: REPLACE_OSS_ACCESS_KEY_ID
    AWS_S3_SECRET_ACCESS_KEY: REPLACE_OSS_ACCESS_KEY_SECRET

    LLM_API_KEY: REPLACE_VOLCENGINE_ARK_API_KEY
    WHISPERX_API_KEY: REPLACE_VOLCENGINE_ARK_API_KEY

    CELERY_BROKER_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/2
    CELERY_RESULT_BACKEND: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/2
    TASK_TRACKER_REDIS_URL: redis://default:REPLACE_REDIS_PASSWORD@redis-master:6379/3

celeryTranscribe: *summarySecretEnvVars
celerySummarize:  *summarySecretEnvVars
celerySummaryBackend: *summarySecretEnvVars

agentMetadata:
  envVars:
    LIVEKIT_API_SECRET: REPLACE_LIVEKIT_API_SECRET
    AWS_S3_ACCESS_KEY_ID: REPLACE_OSS_ACCESS_KEY_ID
    AWS_S3_SECRET_ACCESS_KEY: REPLACE_OSS_ACCESS_KEY_SECRET

agentSubtitles:
  envVars:
    LIVEKIT_API_SECRET: REPLACE_LIVEKIT_API_SECRET
    # Doubao Seed-ASR credentials
    DOUBAO_ASR_APP_ID: REPLACE_DOUBAO_ASR_APP_ID
    DOUBAO_ASR_ACCESS_TOKEN: REPLACE_DOUBAO_ASR_ACCESS_TOKEN
    # Same shared secret as backend.envVars.AGENT_INTERNAL_API_TOKEN above
    AGENT_INTERNAL_API_TOKEN: REPLACE_AGENT_INTERNAL_API_TOKEN
    # Sprint 2.1: Doubao Pro LLM key for translation (same Ark account
    # as the AI assistant pipeline).
    ARK_API_KEY: REPLACE_VOLCENGINE_ARK_API_KEY

agentAIAssistant:
  envVars:
    LIVEKIT_API_SECRET: REPLACE_LIVEKIT_API_SECRET
    # ---- Qwen-Omni-Realtime (DashScope) ----
    DASHSCOPE_API_KEY: REPLACE_DASHSCOPE_API_KEY
    # ---- Doubao S2S Omni (Volcengine end-to-end realtime voice) ----
    DOUBAO_S2S_APP_ID: REPLACE_DOUBAO_S2S_APP_ID
    DOUBAO_S2S_ACCESS_KEY: REPLACE_DOUBAO_S2S_ACCESS_KEY
    # ---- Doubao Pipeline (Seed-ASR + VLM/LLM race + Seed-TTS) ----
    ARK_API_KEY: REPLACE_VOLCENGINE_ARK_API_KEY
    DOUBAO_ASR_APP_ID: REPLACE_DOUBAO_ASR_APP_ID
    DOUBAO_ASR_ACCESS_TOKEN: REPLACE_DOUBAO_ASR_ACCESS_TOKEN
    DOUBAO_TTS_APP_ID: REPLACE_DOUBAO_TTS_APP_ID
    DOUBAO_TTS_ACCESS_TOKEN: REPLACE_DOUBAO_TTS_ACCESS_TOKEN

# LiveKit chart - keys block
livekit:
  keys:
    meet: REPLACE_LIVEKIT_API_SECRET
  redis:
    password: REPLACE_REDIS_PASSWORD
  webhook:
    # NOTE: webhook.api_key 是 keys: 块里的 KEY 名字 (用来签 outgoing webhook),
    # 不是一个独立的 secret 值. 当前只有一个 key "meet" 所以填 "meet".
    # LiveKit 用 keys.meet 对应的 secret (== LIVEKIT_API_SECRET) 签 webhook payload,
    # backend 用同一个 secret 验签.
    api_key: meet

# Image pull credentials for 火山引擎 CR
# 注意: 主账号 AK/SK 不能 docker login 火山 CR. 必须在 CR 控制台 → 实例 → 访问凭证
# 创建一个用户名 + 固定密码. username 格式 <custom_user>@<account_id>.
image:
  credentials:
    username: REPLACE_VOLC_CR_USERNAME    # 例如 MYORG2025@2114082505
    password: REPLACE_VOLC_CR_PASSWORD    # 该用户名对应的固定密码
    registry: your-cr.cr-domain.com
    name: meet-dockerconfig

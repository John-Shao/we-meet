# Keep the sampler independent of transcription plugins and model weights.
FROM python:3.13.13-slim AS base

ARG APT_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=20 update \
    && apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=20 install \
       -y --no-install-recommends libglib2.0-0 libgobject-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

FROM base AS builder
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0 UV_COMPILE_BYTECODE=1
WORKDIR /build
COPY requirements-sampler-linux-py313.lock /build/requirements.lock
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/sampler \
    && uv pip sync --python /opt/sampler/bin/python --require-hashes requirements.lock

FROM base AS runtime
ENV PATH="/opt/sampler/bin:$PATH" PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=builder /opt/sampler /opt/sampler
COPY src/voiceprint /app/src/voiceprint
COPY src/entrypoints/voiceprint_sampler.py /app/src/entrypoints/voiceprint_sampler.py
RUN mkdir -p /tmp/sampler && chown 10001:10001 /tmp/sampler
USER 10001:10001
EXPOSE 8094
CMD ["python", "-m", "entrypoints.voiceprint_sampler", "start"]

# The final/default stage stays production; tests use --target verification.
FROM runtime AS verification
COPY tests/test_voiceprint_sampling.py tests/test_voiceprint_runtime.py /app/tests/
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_voiceprint_*.py", "-v"]

FROM runtime AS production

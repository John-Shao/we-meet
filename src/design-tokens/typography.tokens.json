{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "WeMeet cross-client typography contract based on the Material 3 type scale. Web uses rem; Android maps px to sp.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "ui": {
        "$value": [
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "Roboto",
          "Noto Sans",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    }
  },
  "typography": {
    "$type": "typography",
    "displayLarge": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": { "value": 57, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": -0.25, "unit": "px" },
        "lineHeight": 1.122807
      }
    },
    "displayMedium": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": { "value": 45, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.155556
      }
    },
    "displaySmall": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": { "value": 36, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.222222
      }
    },
    "headlineLarge": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": { "value": 32, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.25
      }
    },
    "headlineMedium": {
      "$value": {
        "fontFamily": "{font.family.ui}",
        "fontSize": { "value": 28, "unit": "px" },

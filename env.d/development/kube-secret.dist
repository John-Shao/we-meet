WHISPERX_BASE_URL=https://configure-your-url.com
WHISPERX_API_KEY=<key>
LLM_BASE_URL=https://configure-your-url.com
LLM_API_KEY=<key>
# dev 登录（手机 OTP demo 账号）—— 仅本地 dev，生产走火山引擎 SMS + bootstrap-mobile.sh
# secret 值需与 dev Keycloak 里建的 meet-service 客户端 secret 一致（见 docs/installation/local-dev-tilt-windows-cn.md）
MOBILE_AUTH_SERVICE_CLIENT_SECRET=dev-meet-service-secret-0123456789
MOBILE_AUTH_DEMO_OTP=123456
MOBILE_AUTH_DEMO_PHONES=13800000000,13800000001,13800000002,13800000003,13800000004,13800000005,13800000006,13800000007,13800000008,13800000009

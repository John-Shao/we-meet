# Copy to capture_translation locally; credentials must stay untracked.
# Put a local TLS proxy in front of port 8093 for the client's WSS-only contract.
CAPTURE_TRANSLATION_GATEWAY_ENABLED=false
CAPTURE_TRANSLATION_ORIGINS=http://localhost:3000
AGENT_BACKEND_API_URL=http://app-dev:8000
AGENT_INTERNAL_API_TOKEN=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
QWEN_TRANSLATION_MODEL=qwen3.8-livetranslate-flash-realtime
QWEN_TRANSLATION_LANGUAGES=zh,en

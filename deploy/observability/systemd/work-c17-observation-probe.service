[Unit]
Description=Work C17 read-only observation probe
After=network-online.target work-api.service

[Service]
Type=oneshot
User=work-observability
Group=work-observability
ExecStart=/usr/local/bin/work-c17-observation-probe
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Copy to .env and fill in. Never commit .env.
#
# 生成强密码:
#   openssl rand -base64 24

# Keycloak admin (访问 https://id.example.com/admin/)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=REPLACE_ADMIN_PASSWORD

# Keycloak's own postgres
KC_DB_PASSWORD=REPLACE_DB_PASSWORD

# Phone-auth 插件短信网关（bootstrap-phone-auth.sh 用）
#   SMS_GATEWAY_URL           : backend 的 keycloak-sms 网关端点
#   KEYCLOAK_SMS_GATEWAY_TOKEN: 必须与 backend values.secrets.yaml 的
#                               KEYCLOAK_SMS_GATEWAY_TOKEN 逐字符同值
SMS_GATEWAY_URL=https://meet.we-meet.online/keycloak-sms/send/
KEYCLOAK_SMS_GATEWAY_TOKEN=REPLACE_KEYCLOAK_SMS_GATEWAY_TOKEN

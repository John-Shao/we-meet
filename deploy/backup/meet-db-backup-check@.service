[Unit]
Description=Check independent offsite database backup (%i)
After=network-online.target
OnFailure=meet-db-backup-notify@%i.service
OnSuccess=meet-db-backup-notify@%i.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/meet-db-backup/database_backup.py %i check
TimeoutStartSec=5min
PrivateTmp=true
NoNewPrivileges=true

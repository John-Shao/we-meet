      "requiresConfirm": false
    },
    "view_artifact_readonly": {
      "labelKey": "work.r0a.action.view_artifact_readonly",
      "destructive": false,
      "requiresConfirm": false
    },
    "export": {
      "labelKey": "work.r0a.action.export",
      "destructive": false,
      "requiresConfirm": false
    },
    "continue": {
      "labelKey": "work.r0a.action.continue",
      "destructive": false,
      "requiresConfirm": false
    },
    "view_error": {
      "labelKey": "work.r0a.action.view_error",
      "destructive": false,
      "requiresConfirm": false
    },
    "view_timeline": {
      "labelKey": "work.r0a.action.view_timeline",
      "destructive": false,
      "requiresConfirm": false
    },
    "view_budget": {
      "labelKey": "work.r0a.action.view_budget",
      "destructive": false,
      "requiresConfirm": false
    },
    "rename": {
      "labelKey": "work.r0a.action.rename",
      "destructive": false,
      "requiresConfirm": false
    },
    "delete": {
      "labelKey": "work.r0a.action.delete",
      "destructive": true,
      "requiresConfirm": true
    }
  },
  "constraints": {
    "accept": {
      "onlyStates": [
        "awaiting_acceptance"
      ],
      "requiresPendingAcceptance": true,
      "requiresNoBlockingOperations": true
    },
    "retry": {
      "onlyStates": [
        "failed",
        "run_canceled"
      ]
    },
    "cancel": {
      "onlyStates": [
        "queued",
        "running",
        "budget_exhausted",
        "reconciling"
      ]
    }
  },
  "management": {
    "rename": {
      "states": [
        "open",
        "queued",
        "running",
        "awaiting_acceptance",
        "completed",
        "failed",
        "run_canceled",
        "reconciling",
        "budget_exhausted",
        "canceling"
      ],
      "desktopOnly": true
    },
    "delete": {
      "states": [
        "open",
        "awaiting_acceptance",
        "completed",
        "failed",
        "run_canceled"
      ],
      "requiresQuiescent": true
    }
  }

[
  {
    "id": "02630a7331a618833d65a6c765a7e1c00e435da81ef2a95aa71451cd427fbc59",
    "text": "讨论记录2\n差旅报销总计900元。"
  },
  {
    "id": "02669397065e52c22e13fbbe6c1d07e94a42a93ca4c0bff417336094bcc3dd96",
    "text": "项目讨论\n回滚使用经过验证的稳定镜像。"
  },
  {
    "id": "08cbb1e8b46e28bca0fe60da058946d86c44b0087b67680ede6ba8da6694bf1b",
    "text": "讨论记录3\n需求评审尚未开始。"
  },
  {
    "id": "0b764f0c1dbd528000f89602de70cc84a25d1eb505867c68f09d787bad40ba62",
    "text": "讨论记录3\n数据备份每天凌晨执行。"
  },
  {
    "id": "0ef0e22b3065ff4c0c54d7b071ac676ed73dd4167c2f7bdce5ebd00202251d84",
    "text": "讨论记录2\n历史合同需保存五年。"
  },
  {
    "id": "0effb0f912d17912ed31975ff0218e1f9a5201eaded74b3ad9649593a5a21eb3",
    "text": "讨论记录0\n发布失败时回滚到上一个稳定镜像。"
  },
  {
    "id": "0f9e17783a9e9745a48140fdbfc98abd98f978af672600dbecff567606e4e110",
    "text": "讨论记录1\n物流包裹已退回发货人。"
  },
  {
    "id": "19ceb4cf2b8392f341bca5d0b1f2f10ab91dab75f889b554e8c974caefc4b78b",
    "text": "讨论记录1\n差旅额度为两千元。"
  },
  {
    "id": "22d7aee9f79896f9c4c8d086770e6ec8d819600f6c13a1af91dcc70acbdac935",
    "text": "项目讨论\n任务负责人为赵明。"
  },
  {
    "id": "2324354dea0698b0db9414cf63d62e1189f60b40604f4ab927f70b70daee3989",
    "text": "项目讨论\n开场白。"
  },
  {
    "id": "24cf327fe9d25801cc9e24fa0ae7da5e3df776efc6cc048b10b35419924d4fd1",
    "text": "发布失败后怎么回退？"
  },
  {
    "id": "282ece8145c502b7d6cff8a989817615e44a2d970340e0e19d86360630677d85",
    "text": "Will it rain in Paris tomorrow?"
  },
  {
    "id": "2e814a5f8cd853c9e7456f668981088f8dd9defa2c0eabcd48988384ebea81cc",
    "text": "讨论记录2\n试用活动本周结束。"
  },
  {
    "id": "3016deb83e2b672862d4b0f533613f57f33c280ca58705b670e044cf9a935a14",
    "text": "项目讨论\n回滚方案为恢复上一稳定版本。"
  },
  {
    "id": "303ef0db1e05dc4de17421212fe842b13cdb683af917fa6fa57e41f85df839ac",
    "text": "讨论记录1\n客户退货统一走售后渠道。"
  },
  {
    "id": "347efd0710bb49c756a071f9222e3a735b5c1c296a01602cf9bc0507a455cbca",
    "text": "Who approved the budget for ZXQ997?"
  },
  {
    "id": "34d0adc4ab20b4180a81be3db848b78888791e125c8b9ae898dbc9b0935d774f",
    "text": "讨论记录1\n巴黎分部采购电脑的预算已批准。"
  },
  {
    "id": "3d1c6e67c93a9f309fc6a526459b88b5534b766460d63fd356be62994b25f139",
    "text": "讨论记录2\n本周日程保持不变。"
  },
  {
    "id": "47f67d98094d7ccd30339c4f310bddb62ab96d9ee15735130beec6ebc7b8d331",
    "text": "项目讨论\n数据库回滚使用上一个稳定镜像。"
  },
  {
    "id": "49126204a38bc55da76447d4c41dfe2b2ff8720b3c99f792224a7334fdb279e7",
    "text": "讨论记录0\n正式上线日期定于11月2日。"
  },
  {
    "id": "4992ceeb406778f1c71aea4c4ca320d505e9ccf72590ebe063036c55b7d5d6cc",
    "text": "ZXQ997计划花多少银子？"
  },
  {
    "id": "4eb621a872c6375bee38dbfe958971eb7ae03cd37715fa5d64965941f84edda2",
    "text": "讨论记录3\n视频播放时长为四十分钟。"
  },
  {
    "id": "4fe8bfda6e0419e639c6daba6c8b7ea8062059514fa3a6dd5d9f67695aed3c6a",
    "text": "讨论记录2\n讲师王芳讲解了流程。"
  },
  {
    "id": "52195b93d23af13850da9c3b7efbf08ccfe90a9edfcda21cb64394ea8bb4c3ba",
    "text": "ZXQ997花多少银子？"
  },
  {
    "id": "55ca8a3ca08bd911e11b8f09132913c70da45f4c67b43a0e96219346d4118f49",
    "text": "讨论记录0\n预算审批额度为18万元。"
  },
  {
    "id": "5ba4cba65f1d906a677aea7dd3a1b0c1b971dc49b956cf711eee6d7c0e5fccbf",
    "text": "How do we undo a failed deployment?"
  },
  {
    "id": "5dd95b6fd932b5fed30143fc10dd21cefff712336d6113cb688a7b11e4af6266",
    "text": "讨论记录1\n午餐每份价格25元。"
  },
  {
    "id": "6297f35baaed264c6acf5ffc4ca0f009f2bf2e03c3843efd2060e24723b24e2a",
    "text": "项目讨论\nDeployment rollback uses the previous stable image."
  },
  {
    "id": "66dd96e41dfb03597457dcba76d7253121ea3bbdb44e8c084f983da6092751a2",
    "text": "项目讨论\n数据保留期为30天。"
  },
  {
    "id": "6aa694508e3a25b91247dc650f3cf4ce1f5cadf55b3531efede971fae2a8a756",
    "text": "讨论记录0\n项目预算为30万元。"
  },
  {
    "id": "7008830915c00e27431927e21ad4e927c405e601b318a721dbdf9e7d65714b38",
    "text": "讨论记录1\n快递将于明天派送。"
  },
  {
    "id": "701f2bb2f467240496ed343eb1150b18a0a201854b142064de8049b7fc6e7ed3",
    "text": "项目讨论\n费用预算确定为30万元。"
  },
  {
    "id": "705b5503d93e7799e4ffb3fc9bae9482dd1ad49b0475c9d6a815f179ec866ead",
    "text": "讨论记录1\n供应商合同已经签署。"
  },
  {
    "id": "71874d7e6346ae4099dcb030d8e3945cc51552b3c6f92cd1f9ec9ee881081bbc",
    "text": "讨论记录0\n正式上线定于11月2日。"
  },
  {
    "id": "73db01ed1e765b469d7a689221f8825061721979c7ba6db27293f471a6fe0e7d",
    "text": "项目讨论\n产品上线日期定为11月2日。"
  },
  {
    "id": "7cc105db8f4ccfc1893b3561aad2658039da821c1aed5eda9f9141c94b66b23e",
    "text": "How is diabetes treated?"
  },
  {
    "id": "7e22f0d0f8a395c6f2de55a8c3f23d392acd2bdcd17c75c98d4cc9d53a78020e",
    "text": "这项活儿该找谁牵头？"
  },
  {
    "id": "7fdd83ecd5e1a7b86e5176f64c0227100cb9fd2ae29992a942c6522e06953d8a",
    "text": "讨论记录3\n审计员刘平会参加下周会议。"
  },
  {
    "id": "84150faed99d1416e6ea549285feac9c0eb0a2ddbb0c35276f83543d924fec6b",
    "text": "When is the product launch?"
  },
  {
    "id": "88c1c29b9ad41214f3968ba4c4b187cb727ea25df9bfe323022afa6ce2dfb284",
    "text": "这轮得掏多少银子？"
  },
  {
    "id": "8d4f81c68cace21716eaa830f6973f22dbf0b51f95484e2adf717812eb6bc221",
    "text": "讨论记录1\n登录令牌有效期为一小时。"
  },
  {
    "id": "9534462ebfee2e0162f0f47357ea3500aea99c066d583f97f068cb0b1f75f8ee",
    "text": "资料多久会被清掉？"
  },
  {
    "id": "9a992b106d9753be06895fa187d94b92f32a513bd5952c0d72223ffe827bd8ec",
    "text": "上次项目经费最终批了多少？"
  },
  {
    "id": "ac61b98a1e43aad8b7631ce44bb6e4b148e1c11d1feeaa81580fd019a9b68048",
    "text": "ZXQ997的起飞时间？"
  },
  {
    "id": "acd44d80998802cb43f0e36127b9eb19fad5417e37d269709e46ef1b6d25bb13",
    "text": "讨论记录3\n报价单尚未签字。"
  },
  {
    "id": "ae4f92c4029fe9bf97aa9ce89de9e106832b4692bf39a87a94b87fb9f8791aee",
    "text": "讨论记录0\n录音保留期为30天。"
  },
  {
    "id": "b1f89ed89ad918156ff5410f55b27ba35031a64ca841070d2cf9aa6a08f1fd12",
    "text": "讨论记录1\n发布活动将在晚上八点开始。"
  },
  {
    "id": "b36d5b8b8c38edf488b176a9e4c4193413396e1661b51832fd8dd8c23468331a",
    "text": "讨论记录0\n明天讨论上线计划。"
  },
  {
    "id": "b5e589703462e41000a5411ed213d28ad65494e497d4baec142e1f1e6d5af3b9",
    "text": "How long before recordings expire?"
  },
  {
    "id": "b69632a8895d10f1de3d6c134dbd8febd52a3838639f928c0ac3c672ec857728",
    "text": "讨论记录3\n去年曾在十月开放内测。"
  },
  {
    "id": "b71019b6044a780b938071ba9db629f78773b9a4a4349e89bd05e1500d307a81",
    "text": "讨论记录0\n责任人指定为赵明。"
  },
  {
    "id": "be14607894c471967c8613808f39d03359e66ea5954e8bd53973f8fedf4af24a",
    "text": "What is the return policy for these shoes?"
  },
  {
    "id": "c0c7e6b39704a04e09dba903eb9c75ee3a49f8596800078208e9bd9aae455da5",
    "text": "项目讨论\n其他项目预算批准18万元。"
  },
  {
    "id": "c1b7ee5193e7911bf26484a20ce42430b1a8a981aa97eed4c16a90eb8c5a0309",
    "text": "讨论记录0\n另一项目预算批准18万元。"
  },
  {
    "id": "c64205ce0e89cd09b7e1afdc6c3d5a45df1149c06eafcbf4f44d90734b3dfd2c",
    "text": "讨论记录1\n联系人陈宇负责发票收件。"
  },
  {
    "id": "c82050faaa004f3eb0a1f71c729344abae25395ee931d092548702a56b5bcb28",
    "text": "讨论记录0\n其他项目的预算由张明审批。"
  },
  {
    "id": "c899de3103d2869bdbf911fcaca41587a6a94ca2e8c2241726dcc742511c03ea",
    "text": "这个包怎么退回去？"
  },
  {
    "id": "cbe8bffa9382d7adaa5ff84697e00ee2c1c7463c712b24d7470d0501ce1676b1",
    "text": "这次得掏多少银子？"
  },
  {
    "id": "d6591c0da81b86938f5397cf2de31de3142f62e00d474d23c33a7ded235c63bf",
    "text": "讨论记录1\n服务器扩容到八个节点。"
  },
  {
    "id": "d9f49898cf075422bd297691165c65cc57b6b8e037aea40a4313660b50def3ef",
    "text": "讨论记录0\n交付已延期至12月8日。"
  },
  {
    "id": "da25480fb483e6ce3d30f1a179c3c07e9f3b045425b0ac54acc6758a97e2db62",
    "text": "rollback"
  },
  {
    "id": "e52f369dcbdc5ed965ba99dc3657b31bb58af1beba7de3521a08b92c4d53a5f2",
    "text": "这项活儿由谁牵头？"
  },
  {
    "id": "e9c8d40d84ba29ae8370096f1f9ea1f3336d7e41742de42d51a90766a98cc5dd",
    "text": "deployment rollback"
  },
  {
    "id": "ec4e98c623979d88ead68a651b8f30e378921192e9de59cc288366d97b90af1d",
    "text": "项目讨论\n预算批准为18万元。"
  },
  {
    "id": "ed3b079ba5447ec80cb4aac4f5b9aa13dd779857bd38efa9096e1792ca30860e",
    "text": "讨论记录1\n数据库恢复需要先停止写入。"
  },
  {
    "id": "fe22ac46a52040a6ca7ab827205db1e24607e783d066ec9292c13f95be0629d2",
    "text": "讨论记录2\n撤销请假申请需要主管批准。"
  },
  {
    "id": "fe7ebdc56368fd7cb13cc1f559a826df03429a17d8e3529b09306e12414821c1",
    "text": "When do we ship the product?"
  },
  {
    "id": "ff032309c7a7eb8abb2ca54fb112b363faa20559838c26343a71affc56e74c16",
    "text": "Did the delivery get pushed back?"
  }
]
